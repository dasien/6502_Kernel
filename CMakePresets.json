{
  "version": 2,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 20,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "dev",
      "displayName": "Dev (optimized + tests)",
      "description": "Default developer build: an optimized emulator with the ctest suite enabled.",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/cmake-build-debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "BUILD_TESTS": "ON"
      }
    },
    {
      "name": "debug",
      "displayName": "Debug (-O0 -g + tests)",
      "description": "Unoptimized build for stepping through the emulator in a debugger. The 6502 runs noticeably slower than in the dev preset.",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/cmake-build-debug-g",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "BUILD_TESTS": "ON"
      }
    },
    {
      "name": "release",
      "displayName": "Release (no tests)",
      "description": "Optimized build without the test suite.",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/cmake-build-release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "BUILD_TESTS": "OFF"
      }
    },
    {
      "name": "no-gui",
      "displayName": "Console only (no Qt)",
      "description": "Builds without Qt even if it is installed. Produces the host tools and a non-interactive console demo -- not the usable machine.",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/cmake-build-nogui",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "BUILD_TESTS": "ON",
        "CMAKE_DISABLE_FIND_PACKAGE_Qt6": "ON",
        "CMAKE_DISABLE_FIND_PACKAGE_Qt5": "ON"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "dev",
      "configurePreset": "dev"
    },
    {
      "name": "dev-disk",
      "displayName": "Assemble disk.img",
      "configurePreset": "dev",
      "targets": [
        "disk"
      ]
    },
    {
      "name": "debug",
      "configurePreset": "debug"
    },
    {
      "name": "release",
      "configurePreset": "release"
    },
    {
      "name": "no-gui",
      "configurePreset": "no-gui"
    }
  ],
  "testPresets": [
    {
      "name": "dev",
      "configurePreset": "dev",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "debug",
      "configurePreset": "debug",
      "output": {
        "outputOnFailure": true
      }
    }
  ]
}
