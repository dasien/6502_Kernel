# SPRDEMO's pictures, built into sprdemo_art.c by spr2c at build time.
#
# 4 bits a pixel: '.' is transparent and a hex digit is a palette slot. The default
# palette is ANSI order: 1 red, 3 brown, 4 blue, 8 grey, 9 bright red, B bright
# yellow, C bright blue, F white. A 16x32 picture is two slots, top then bottom.

# a smiley
@sprite art_smile 16x16
.....333333.....
...33BBBBBB33...
..3BBBBBBBBBB3..
.3BBBBBBBBBBBB3.
.3BBB44BB44BBB3.
3BBBB44BB44BBBB3
3BBBB44BB44BBBB3
3BBBBBBBBBBBBBB3
3BBBBBBBBBBBBBB3
3BB1BBBBBBBB1BB3
3BBB1BBBBBB1BBB3
.3BBB111111BBB3.
.3BBBBBBBBBBBB3.
..3BBBBBBBBBB3..
...33BBBBBB33...
.....333333.....

# ...blinking
@sprite art_blink 16x16
.....333333.....
...33BBBBBB33...
..3BBBBBBBBBB3..
.3BBBBBBBBBBBB3.
.3BBBBBBBBBBBB3.
3BBB444BB444BBB3
3BBBBBBBBBBBBBB3
3BBBBBBBBBBBBBB3
3BBBBBBBBBBBBBB3
3BB1BBBBBBBB1BB3
3BBB1BBBBBB1BBB3
.3BBB111111BBB3.
.3BBBBBBBBBBBB3.
..3BBBBBBBBBB3..
...33BBBBBB33...
.....333333.....

