{
  "agents_directory": ".claude/agents",
  "enhancements_directory": "enhancements",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bd prime --hook-json 2>/dev/null || true"
          }
        ]
      }
    ]
  },
  "permissions": {
    "deny": [
      "Edit(.claude/**)",
      "Edit(.abacus/**)",
      "Edit(.githooks/**)"
    ]
  }
}
